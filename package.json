{
  "name": "community-stellar-badge",
  "version": "0.0.0",
  "description": "A Built on Stellar badge served as a static SVG from a CDN",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devodii/community-stellar-badge.git"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.18.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "badges"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup && pnpm build:badges",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "simple-git-hooks",
    "generate:logo": "tsx scripts/logo.ts",
    "generate:fonts": "tsx scripts/fonts.ts",
    "generate": "pnpm generate:logo && pnpm generate:fonts",
    "check:generated": "pnpm generate && git diff --exit-code -- src/generated",
    "build:badges": "tsx scripts/badges.ts",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "fontkit": "^2.0.4",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit $1"
  }
}
